{
  "name": "ridenite-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RideNite v1 iPhone PWA. SIMULATED DEMO with fictional sample data only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "lint:copy": "node scripts/copy-lint.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@fontsource/libre-baskerville": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
